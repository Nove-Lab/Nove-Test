# Standard .NET build artifacts — generated by ``dotnet test``; never
# committed. The dev gate runs ``dotnet test`` against a ``tmp_path``
# copy of this fixture, so the fixture itself stays clean.
bin/
obj/
TestResults/

# Coverlet runsettings is generated by the adapter PER-RUN under
# ``<artifact_dir>/native/coverlet.runsettings``. The fixture never
# ships one — that would couple the fixture to a single Coverlet config.
coverlet.runsettings
