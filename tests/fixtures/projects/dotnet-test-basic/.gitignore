# Standard .NET build artifacts — generated by ``dotnet test``; never
# committed. The CI/dev gate runs ``dotnet test`` against this fixture and
# materializes these directories on the fly under ``tmp_path`` copies; the
# fixture itself stays clean.
bin/
obj/
TestResults/

# Coverlet runsettings is generated by the adapter PER-RUN under
# ``<artifact_dir>/native/coverlet.runsettings``. The fixture never ships
# one — that would couple the fixture to a single Coverlet configuration.
coverlet.runsettings
