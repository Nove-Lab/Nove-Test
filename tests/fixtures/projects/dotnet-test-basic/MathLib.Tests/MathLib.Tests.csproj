<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Versions pinned to the supported-engine-matrix floors per
      decisions/2026-05-25-supported-engine-matrix.md + the Coverlet 6.0.2
      floor pinned by decisions/2026-06-03-coverlet-pertestcoverage-key.md.
      Do NOT downgrade xunit to 2.5.x (the default `dotnet new xunit`
      template's pin) — 2.6 is the minimum floor for the supported feature
      set. Do NOT upgrade xunit to 3.x — v3 detection routes to the
      `xunit-v3-coverage-deferred` warning per decision §6.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MathLib\MathLib.csproj" />
  </ItemGroup>

</Project>
