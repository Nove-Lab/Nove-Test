<?xml version="1.0" encoding="UTF-8"?>
<!--
  Controlled SuT fixture for the JUnit adapter integration tests.

  Deterministic, isolated, no `novetest` imports. The `subtract`
  method in `Calculator.java` has a one-line bug (returns `a - b - 1`
  instead of `a - b`) so `CalculatorTest#testSubtract` reliably fails;
  the other four tests pass / skip predictably. Coverage runs via the
  bundled JaCoCo plugin and emit `target/site/jacoco/jacoco.xml`.

  Floor versions match `scripts/dev-host-setup.md §5` + the
  supported-engine matrix (JDK 17, Maven Surefire 3.0+, JaCoCo 0.8.11+,
  JUnit Jupiter 5.10+).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.novetest.fixture</groupId>
    <artifactId>junit-maven-basic</artifactId>
    <version>0.0.1</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
