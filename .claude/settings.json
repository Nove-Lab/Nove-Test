{
  "permissions": {
    "allow": [
      "Bash(sudo apt-get update)",
      "Bash(sudo apt-get update *)",
      "Bash(sudo apt-get install -y openjdk-17-jdk*)",
      "Bash(sudo apt-get install -y maven*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-worklog-before-commit.sh"
          }
        ]
      }
    ]
  }
}
